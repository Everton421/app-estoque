{
  "expo": {
    "name": "app-estoque",
    "slug": "new-app-estoque",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/splash-intersig.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "android": {
      "splash": {
        "image": "./assets/splash-intersig.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-intersig.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.everton421.newappestoque"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86cd2c3c-2da4-49fa-b44e-8c97445551a2"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minifyWithProguard": true,
            "newArchEnabled": true
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}